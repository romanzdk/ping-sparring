# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pingsparring

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Email (SMTP)
# Pro Gmail: Vytvořte "App Password" v Google Account nastavení
# https://myaccount.google.com/apppasswords
# Port 587 používá STARTTLS, port 465 používá přímé TLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@pingsparring.cz
CONTACT_EMAIL=  # Volitelné - kam chodí zprávy z kontaktního formuláře (default: SMTP_FROM_EMAIL)

# Frontend
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development
