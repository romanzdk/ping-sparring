# Build stage - use slim (Debian) instead of alpine to avoid musl/glibc rollup issues
FROM node:20-slim AS builder

WORKDIR /app

# Accept build args
# VITE_API_URL should be set to the backend URL (e.g., https://backend.onrender.com)
# Leave empty for same-origin requests (requires nginx proxy)
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL

# Copy only package.json (ignore package-lock.json to get correct platform binaries)
COPY package.json ./

# Fresh install to get correct native binaries for Linux x64
RUN npm install

# Copy source files
COPY . .

# Build the application
RUN npm run build

# Production stage - serve with nginx
FROM nginx:alpine

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration for SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
